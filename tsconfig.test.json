{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-out",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "tests/**/*.ts"]
}
