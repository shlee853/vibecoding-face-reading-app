# OpenRouter API Key (https://openrouter.ai/keys 에서 발급 받으세요)
# 모델: google/gemma-4-26b-a4b-it:free (Apache 2.0, 무료 티어)
#
# ⚠️ 무료 티어는 요청 데이터가 로깅/모델 개선에 쓰일 수 있습니다.
# 이 앱은 사용자 얼굴 사진을 보내므로, 운영 전 OpenRouter의 데이터 정책을
# 반드시 다시 확인하세요: https://openrouter.ai/docs/features/privacy-and-logging
OPENROUTER_API_KEY=your_api_key_here

# ── 로컬 개발 전용: Ollama로 전환 ──────────────────────────────────────────
# OpenRouter 무료 티어가 공유 풀 혼잡으로 반복 테스트를 막을 때, 로컬 Ollama로
# 우회할 수 있습니다. 아래 두 줄의 주석을 풀면 OPENROUTER_API_KEY 대신 이걸 씁니다.
# ⚠️ 운영 서버에는 절대 쓰지 마세요 — Ollama는 인증이 없고, PC가 24시간 켜져 있어야 합니다.
# AI_PROVIDER=ollama
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_BASE_URL=http://localhost:11434
